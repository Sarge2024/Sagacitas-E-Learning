{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Sagacitas Event Flow Topology",
    "subtitle": "Event streams, topics, processors, state stores, and DLQ",
    "output": "event-topology.html",
    "viewBox": [1080, 780],
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "standard",
    "views": [
      { "id": "tutor-transit", "label": "Tutor Event Transit", "focus": ["spa", "topic_interactions", "processor_audit", "state_history", "consumer_analytics"], "note": "Follow an interaction from producer to analytics." },
      { "id": "failure-and-replay", "label": "Failure and Replay", "focus": ["processor_audit", "processor_enrich", "dlq", "replay", "ops"], "note": "Isolate dead letters and controlled replay ownership." }
    ]
  },
  "stages": [
    { "label": "Producers" },
    { "label": "Transit" },
    { "label": "Processors" },
    { "label": "State + Recovery" },
    { "label": "Consumers" }
  ],
  "nodes": [
    { "id": "spa", "type": "frontend", "label": "Student SPA", "sublabel": "interaction producer", "stage": 0, "row": 0 },
    { "id": "tutor_api", "type": "backend", "label": "Tutor API", "sublabel": "response producer", "stage": 0, "row": 2 },
    
    { "id": "topic_interactions", "type": "messagebus", "label": "Interactions", "sublabel": "topic", "stage": 1, "row": 0 },
    { "id": "topic_responses", "type": "messagebus", "label": "Responses", "sublabel": "topic", "stage": 1, "row": 2 },
    
    { "id": "processor_audit", "type": "backend", "label": "Audit Processor", "sublabel": "processor", "stage": 2, "row": 0 },
    { "id": "processor_enrich", "type": "backend", "label": "Context Enricher", "sublabel": "processor", "stage": 2, "row": 2 },
    
    { "id": "state_history", "type": "database", "label": "Chat History", "sublabel": "state store", "stage": 3, "row": 1 },
    { "id": "dlq", "type": "messagebus", "label": "events.dlq", "sublabel": "poison events", "stage": 3, "row": 4 },
    
    { "id": "consumer_analytics", "type": "database", "label": "Analytics DB", "sublabel": "student metrics", "stage": 4, "row": 0 },
    { "id": "replay", "type": "security", "label": "Replay Tool", "sublabel": "approved batch", "stage": 4, "row": 4 },
    { "id": "ops", "type": "external", "label": "Data Ops", "sublabel": "DLQ owner", "stage": 4, "row": 3, "yOffset": -18 }
  ],
  "flows": [
    { "from": "spa", "to": "topic_interactions", "label": "InteractionStarted", "variant": "emphasis", "route": "straight" },
    { "from": "tutor_api", "to": "topic_responses", "label": "ResponseGenerated", "variant": "emphasis", "route": "straight" },
    
    { "from": "topic_interactions", "to": "processor_audit", "label": "raw interactions", "variant": "emphasis", "route": "straight" },
    { "from": "topic_responses", "to": "processor_enrich", "label": "ai responses", "variant": "emphasis", "route": "straight" },
    
    { "from": "processor_audit", "to": "state_history", "label": "audited event", "variant": "emphasis", "route": "vertical-channel" },
    { "from": "processor_enrich", "to": "state_history", "label": "enriched response", "variant": "default", "route": "vertical-channel" },
    
    { "from": "state_history", "to": "consumer_analytics", "label": "history facts", "variant": "emphasis", "route": "vertical-channel" },
    
    { "from": "processor_audit", "to": "dlq", "label": "invalid event", "variant": "security", "fromSide": "top", "toSide": "top", "via": [[530, 80], [20, 80], [20, 550], [745, 550]], "labelAt": [300, 550] },
    { "from": "processor_enrich", "to": "dlq", "label": "poison event", "variant": "security", "route": "bottom-channel", "labelDy": 30 },
    
    { "from": "dlq", "to": "ops", "label": "failure sample", "variant": "security", "route": "vertical-channel" },
    { "from": "dlq", "to": "replay", "label": "approved replay", "variant": "dashed", "route": "straight", "labelDy": 30 }
  ],
  "cards": [
    { "dot": "amber", "title": "Topology Mapping", "items": ["This diagram maps the logical event producers, topics, processors, and state stores.", "The topology includes re-execution paths, dead letter queues (DLQ), and consumers."] },
    { "dot": "rose", "title": "Undefined Constraints", "items": ["There is currently no evidence in the repository to define specific delivery semantics (e.g. at-least-once, exactly-once).", "Ownership boundaries and consumer groups are unspecified.", "Partition strategies, retention policies, and schema versioning are not yet enforced."] }
  ]
}
